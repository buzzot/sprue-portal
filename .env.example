# ── Sprue portal — environment variables ──────────────────────
# Copy to ".env" for local dev, and set the same keys in Railway →
# your service → Variables.  NEVER commit the real .env file.

# Supabase → Project Settings → Data API / API keys
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role secret — server only, keep private!

# The single shared passcode your team uses to open the admin console
ADMIN_PASSCODE=change-me-to-something-long

# Any long random string — signs admin login sessions
SESSION_SECRET=change-me-to-a-40+char-random-string

# ── Email (Resend) — required for email verification & password reset ──
# Create a free account at resend.com, add an API key here, and verify a
# sender domain (e.g. highsb.com) so EMAIL_FROM can send from it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=Sprue <noreply@inquiry.highsb.com>
# Public URL of the site — used to build the links inside emails.
APP_URL=https://inquiry.highsb.com

# Optional — defaults shown
STORAGE_BUCKET=attachments
# PORT is provided automatically by Railway; only set locally if you want.
PORT=3000
